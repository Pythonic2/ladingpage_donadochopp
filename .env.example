DJANGO_ENV=production
DEBUG=false
SECRET_KEY=change-me
ALLOWED_HOSTS=.run.app,vendas.donadochopp.com.br
CSRF_TRUSTED_ORIGINS=https://*.run.app,https://vendas.donadochopp.com.br
DJANGO_SECURE_SSL_REDIRECT=true

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SCHEMA=ladingpageddc
DB_SSLMODE=require
DB_CHANNEL_BINDING=require
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media
SERVE_MEDIA=false

GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=false

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_BACK_URL_BASE=
